{
  "name": "bokerr-api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate": "wrangler d1 execute bokerr --remote --file schema.sql",
    "test": "tsx --test src/*.test.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test && wrangler deploy --dry-run"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261016.1",
    "tsx": "^4.23.15",
    "wrangler": "^4.151.1"
  },
  "dependencies": {
    "boardgame.io": "^0.50.2"
  }
}
